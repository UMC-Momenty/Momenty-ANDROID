<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_bg">

    <!-- 상단 여백 (상태바) -->
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 날짜 및 알림 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/status_bar">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026.02.02"
                android:textSize="20sp"
                android:textColor="@color/text_body_1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_moment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="쌓인 모먼티 21개"
                android:textSize="11sp"
                android:textColor="@color/text_caption_1"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 발바닥 아이콘 (반려동물 선택) -->
        <ImageView
            android:id="@+id/btn_pet_selection"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_top_sole_orange"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="반려동물 선택" />

        <!-- 알림 버튼 -->
        <ImageView
            android:id="@+id/btn_notification"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/notification_top_bar"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="알림" />
    </LinearLayout>

    <!-- 오늘의 질문 카드 (284x85dp) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_question"
        android:layout_width="284dp"
        android:layout_height="85dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="오늘의 질문"
                android:textSize="15sp"
                android:textColor="@color/text_body_1"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_edit_question" />

            <ImageView
                android:id="@+id/iv_edit_question"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bottom_nav_record"
                android:scaleType="fitCenter"
                android:contentDescription="수정"
                app:tint="@color/primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 캐릭터 배경 영역 (높이 제한) -->
    <FrameLayout
        android:id="@+id/character_area"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:background="@drawable/home_character_standing_background"
        app:layout_constraintTop_toBottomOf="@id/card_question"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_menu"
        android:layout_marginTop="24dp">

        <!-- 말풍선 (질문 작성 중) -->
        <ImageView
            android:id="@+id/iv_character_saying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/home_character_saying"
            android:scaleType="fitCenter"
            android:layout_gravity="top|start"
            android:layout_marginStart="40dp"
            android:layout_marginTop="40dp"
            android:visibility="gone"
            android:contentDescription="말풍선" />

        <!-- 물고기 말풍선 (먹이 주기) -->
        <ImageView
            android:id="@+id/iv_character_saying_fish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/home_character_saying_fish"
            android:scaleType="fitCenter"
            android:layout_gravity="top|start"
            android:layout_marginStart="40dp"
            android:layout_marginTop="40dp"
            android:visibility="gone"
            android:contentDescription="물고기 말풍선" />

        <!-- 캐릭터 이미지 (더 작게) -->
        <ImageView
            android:id="@+id/iv_character"
            android:layout_width="160dp"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:contentDescription="캐릭터"
            android:scaleType="fitCenter"
            android:src="@drawable/cheesecat_action1" />

        <!-- 밥그릇 -->
        <ImageView
            android:id="@+id/iv_food_bowl"
            android:layout_width="80dp"
            android:layout_height="38dp"
            android:src="@drawable/home_character_dish"
            android:scaleType="fitCenter"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="80dp"
            android:contentDescription="밥그릇" />

        <!-- 작성 버튼 (우하단) -->
        <ImageView
            android:id="@+id/btn_write_moment"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/home_pencil_for_moment"
            android:scaleType="fitCenter"
            android:contentDescription="작성" />
    </FrameLayout>

    <!-- 하단 네비게이션 바 -->
    <include
        android:id="@+id/bottom_navigation_menu"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>