<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="50dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tv_home_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026.02.11"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/body_1"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/tv_moment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="쌓인 모먼티 20개"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/body_2"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/btn_pet_selection"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_home_btn_footstep"
                android:layout_marginEnd="16dp" />
            <ImageView
                android:id="@+id/btn_notification"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_home_alarm" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_card_question"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="50dp"
        android:text="오늘 먼티의 기분은 어땠나요?"
        android:fontFamily="@font/pretendard_regular"
        android:textSize="18sp"
        android:gravity="center"
        android:background="@drawable/bg_edittext_normal"
        app:layout_constraintTop_toBottomOf="@id/header"/>

    <ImageView
        android:id="@+id/iv_question_pencil"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_home_pencil"
        app:layout_constraintEnd_toEndOf="@id/tv_card_question"
        app:layout_constraintBottom_toBottomOf="@id/tv_card_question"/>

    <ImageView
        android:layout_width="91dp"
        android:layout_height="96dp"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="-30dp"
        android:src="@drawable/img_home_bg_mountain"
        app:layout_constraintBottom_toTopOf="@id/iv_home_floor"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_left_mountain"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginBottom="-70dp"
        android:layout_marginStart="-20dp"
        android:src="@drawable/img_home_bg_mountain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/iv_home_floor"/>

    <ImageView
        android:id="@+id/iv_home_floor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/img_login_floor"
        android:paddingTop="30dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/img_login_floor_foot"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/iv_home_bowl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp"
        android:src="@drawable/img_home_bowl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_left_mountain"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_home_char_shadow"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="-20dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_character"
        app:layout_constraintStart_toStartOf="@id/iv_character"
        app:layout_constraintEnd_toEndOf="@id/iv_character"/>

    <ImageView
        android:id="@+id/iv_character"
        android:layout_width="246dp"
        android:layout_height="251dp"
        android:layout_marginBottom="-10dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="150dp"
        android:src="@drawable/img_home_cat_question"
        app:layout_constraintBottom_toTopOf="@id/iv_home_floor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_card_question"/>

    <ImageView
        android:id="@+id/iv_home_to_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        android:src="@drawable/btn_home_to_question"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>