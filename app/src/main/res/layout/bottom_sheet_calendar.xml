<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:id="@+id/tv_bottom_sheet_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2월 11일 수요일"
        android:fontFamily="@font/pretendard_medium"
        android:textSize="16sp"
        android:textColor="@color/body_1"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bottom_sheet_schedules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"/>

    <!-- 일정이 없을 때 표시 -->
    <TextView
        android:id="@+id/tv_no_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/schedule_none"
        android:gravity="center"
        android:fontFamily="@font/pretendard_regular"
        android:textSize="14sp"
        android:textColor="@color/caption_1"
        android:paddingVertical="30dp"
        android:visibility="gone"/>

</LinearLayout>