<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 상단 헤더 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_arrow_back"
            android:layout_width="30dp"
            android:layout_height="35dp"
            android:src="@drawable/img_arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_terms_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textColor="@color/body_1"
            android:fontFamily="@font/pretendard_semibold"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/caption_1"
        android:layout_marginVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"/>

    <LinearLayout
        android:id="@+id/ll_user_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <!-- 프로필 이미지 -->
        <FrameLayout
            android:id="@+id/fl_user_profile"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp">

            <ImageView
                android:id="@+id/iv_user_profile_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_profile_circle_img" />

            <ImageView
                android:id="@+id/iv_user_profile_cam"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:tint="@color/white"
                android:src="@drawable/dot_record_unselected" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_record_camera_btn"
                android:padding="4dp"/>

        </FrameLayout>

    </LinearLayout>


    <!-- 정보 입력칸 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/ll_user_profile">

        <!-- 이름 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name_field"
            android:fontFamily="@font/pretendard_regular"
            android:textSize="14sp"
            android:textColor="@color/caption_1"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="3dp"
            android:padding="10dp"
            android:hint="@string/name_hint"
            android:textSize="16sp"
            android:textColor="@color/caption_1"
            android:background="@drawable/bg_edittext_normal"
            android:drawableEnd="@drawable/img_profile_cancel" />

        <!-- 성별 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gender_field"
            android:fontFamily="@font/pretendard_regular"
            android:textSize="14sp"
            android:textColor="@color/caption_1"
            android:layout_marginTop="20dp"/>

        <!-- 성별 및 생일 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <RadioGroup
                android:id="@+id/rg_user_gender"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:padding="5dp"
                android:background="@drawable/bg_gender_selector">

                <RadioButton
                    android:id="@+id/rb_gender_male"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/gender_male"
                    android:fontFamily="@font/pretendard_regular"
                    android:textSize="16sp"
                    android:textColor="@color/gender_text_selected"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_gender_item" />

                <RadioButton
                    android:id="@+id/rb_gender_female"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/gender_female"
                    android:fontFamily="@font/pretendard_regular"
                    android:textSize="16sp"
                    android:textColor="@color/gender_text_selected"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_gender_item" />

            </RadioGroup>

            <!-- 생년월일 -->
            <EditText
                android:layout_marginStart="20dp"
                android:id="@+id/et_user_birth"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:padding="10dp"
                android:background="@drawable/bg_edittext_normal"
                android:hint="@string/birth_hint"
                android:textSize="16sp"
                android:textColor="@color/caption_1"
                android:drawableEnd="@drawable/ic_bottom_nav_calendar"/>
            
        </LinearLayout>

        <!-- 오늘의 질문 알림 시간 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question_time_field"
            android:fontFamily="@font/pretendard_regular"
            android:textSize="14sp"
            android:textColor="@color/caption_1"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spinner_question_alarm"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_spinner_profile_alarm"
            android:padding="10dp"
            android:spinnerMode="dropdown"/>

        <!-- 체크박스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <CheckBox
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:button="@drawable/btn_radio_selector"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/question_time_unchosen"
                android:fontFamily="@font/pretendard_regular"
                android:textSize="16sp"
                android:textColor="@color/caption_1" />
        </LinearLayout>

    </LinearLayout>

    <!-- 저장 버튼 -->
    <Button
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:text="@string/save"
        android:textColor="@color/caption_3"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold"
        android:background="@drawable/bg_button_agree"
        android:enabled="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>