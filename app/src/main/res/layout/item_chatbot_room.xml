<?xml version="1.0" encoding="utf-8"?>
<!-- 채팅방 아이템 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- 챗봇 아이콘 -->
    <ImageView
        android:id="@+id/iv_chat_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_chatbot_avatar"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle"
        android:padding="8dp"
        android:contentDescription="Chatbot" />

    <!-- 텍스트 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <!-- 채팅방 제목 -->
        <TextView
            android:id="@+id/tv_chat_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="챗봇과의 대화"
            android:textSize="15sp"
            android:textColor="@color/text_body_1"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 마지막 메시지 -->
        <TextView
            android:id="@+id/tv_last_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="마지막 메시지 내용"
            android:textSize="13sp"
            android:textColor="@color/text_caption_1"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 시간 -->
    <TextView
        android:id="@+id/tv_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="방금"
        android:textSize="12sp"
        android:textColor="@color/text_caption_2" />

</LinearLayout>