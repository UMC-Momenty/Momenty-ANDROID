<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".domain.mypage.MyPageFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/white">

        <!-- TODO: Update blank fragment layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:padding="25dp">

            <ImageView
                android:id="@+id/iv_my_page_user_profile"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_ellipse_my_page"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <TextView
                android:id="@+id/tv_my_page_user_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="닉네임"
                style="@style/TextAppearance.App.Body01"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="@id/iv_my_page_user_profile"
                app:layout_constraintBottom_toBottomOf="@id/iv_my_page_user_profile"
                app:layout_constraintStart_toEndOf="@id/iv_my_page_user_profile" />

            <Button
                android:id="@+id/btn_my_page_manage_profile"
                android:layout_width="120dp"
                android:layout_height="35dp"
                android:text="프로필 관리"
                style="@style/TextAppearance.App.Caption03"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/iv_my_page_user_profile"
                app:layout_constraintBottom_toBottomOf="@id/iv_my_page_user_profile"
                android:layout_marginEnd="24dp"/>

            <View
                android:id="@+id/view_my_page_user_profile"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/caption_2"
                app:layout_constraintTop_toBottomOf="@id/iv_my_page_user_profile"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_my_page_pet_profile"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/view_my_page_user_profile"
                app:layout_constraintStart_toStartOf="@id/view_my_page_user_profile"
                app:layout_constraintEnd_toEndOf="@id/view_my_page_user_profile"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_my_page_add_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/rv_my_page_pet_profile"
                app:layout_constraintStart_toStartOf="@id/rv_my_page_pet_profile">

                <ImageView
                    android:id="@+id/iv_my_page_add_pet_profile"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_ellipse_my_page"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_add_my_page"
                    app:layout_constraintStart_toStartOf="@id/iv_my_page_add_pet_profile"
                    app:layout_constraintEnd_toEndOf="@id/iv_my_page_add_pet_profile"
                    app:layout_constraintTop_toTopOf="@id/iv_my_page_add_pet_profile"
                    app:layout_constraintBottom_toBottomOf="@id/iv_my_page_add_pet_profile"/>

                <TextView
                    android:id="@+id/tv_my_page_add_pet_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="반려동물 정보 추가하기"
                    style="@style/TextAppearance.App.Body01"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/iv_my_page_add_pet_profile"
                    app:layout_constraintBottom_toBottomOf="@id/iv_my_page_add_pet_profile"
                    app:layout_constraintStart_toEndOf="@id/iv_my_page_add_pet_profile" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/caption_2"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/layout_my_page_add_pet"/>

            <LinearLayout
                android:id="@+id/layout_my_page_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/divider1">

                <TextView
                    android:text="서비스"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    style="@style/TextAppearance.App.Caption01"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tv_my_page_notification"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="알림"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    style="@style/TextAppearance.App.Body01"
                    android:drawableEnd="@drawable/img_arrow_right" />
                <TextView
                    android:id="@+id/tv_my_page_notice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="공지사항"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    style="@style/TextAppearance.App.Body01"
                    android:drawableEnd="@drawable/img_arrow_right" />
                <TextView
                    android:id="@+id/tv_my_page_customer_center"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="고객센터"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    style="@style/TextAppearance.App.Body01"
                    android:drawableEnd="@drawable/img_arrow_right" />

                <TextView
                    android:id="@+id/tv_my_page_app_info"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="앱 정보"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    style="@style/TextAppearance.App.Body01"
                    android:drawableEnd="@drawable/img_arrow_right" />
            </LinearLayout>

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/layout_my_page_service"/>

            <LinearLayout
                android:id="@+id/layout_my_page_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/divider2">

                <TextView
                    android:id="@+id/tv_my_page_logout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="로그아웃"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    style="@style/TextAppearance.App.Body01"
                    android:drawableEnd="@drawable/img_arrow_right" />
                <TextView
                    android:id="@+id/tv_my_page_unsubscribe"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="계정탈퇴"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    style="@style/TextAppearance.App.Body01"
                    android:textColor="#FF6060"
                    android:drawableEnd="@drawable/img_arrow_right" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>



</FrameLayout>