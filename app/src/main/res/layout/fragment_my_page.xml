<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".domain.mypage.MyPageFragment">

    <!-- TODO: Update blank fragment layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:padding="25dp">

        <ImageView
            android:id="@+id/img_user_profile"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_ellipse_my_page"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <TextView
            android:id="@+id/tv_user_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임"
            style="@style/TextAppearance.App.Body01"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/img_user_profile"
            app:layout_constraintBottom_toBottomOf="@id/img_user_profile"
            app:layout_constraintStart_toEndOf="@id/img_user_profile" />

        <Button
            android:id="@+id/btn_manage_profile"
            android:layout_width="120dp"
            android:layout_height="35dp"
            android:text="프로필 관리"
            style="@style/TextAppearance.App.Caption03"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/img_user_profile"
            app:layout_constraintBottom_toBottomOf="@id/img_user_profile"
            android:layout_marginEnd="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/img_user_profile"/>

        <ImageView
            android:id="@+id/img_pet_profile"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_ellipse_my_page"
            app:layout_constraintTop_toBottomOf="@id/img_user_profile"
            app:layout_constraintStart_toStartOf="@id/img_user_profile" />

        <TextView
            android:id="@+id/tv_pet_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="반려동물 이름"
            style="@style/TextAppearance.App.Body01"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/img_pet_profile"
            app:layout_constraintBottom_toBottomOf="@id/img_pet_profile"
            app:layout_constraintStart_toEndOf="@id/img_pet_profile" />

        <Button
            android:id="@+id/btn_manage_pet"
            android:layout_width="120dp"
            android:layout_height="35dp"
            android:text="반려동물 관리"
            style="@style/TextAppearance.App.Caption03"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/img_pet_profile"
            app:layout_constraintBottom_toBottomOf="@id/img_pet_profile"
            android:layout_marginEnd="24dp"/>

        <!--
        <LinearLayout
            android:id="@+id/layout_add_pet"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/img_pet_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingStart="24dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_ellipse_my_page" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="반려동물 정보 추가하기"
                android:layout_marginStart="12dp"
                android:textColor="#333333"/>
        </LinearLayout>

        -->


        <ImageView
            android:id="@+id/img_add_pet_profile"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_ellipse_my_page"
            app:layout_constraintTop_toBottomOf="@id/img_pet_profile"
            app:layout_constraintStart_toStartOf="@id/img_pet_profile" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_add_my_page"
            app:layout_constraintStart_toStartOf="@id/img_add_pet_profile"
            app:layout_constraintEnd_toEndOf="@id/img_add_pet_profile"
            app:layout_constraintTop_toTopOf="@id/img_add_pet_profile"
            app:layout_constraintBottom_toBottomOf="@id/img_add_pet_profile"/>

        <TextView
            android:id="@+id/tv_add_pet_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="반려동물 정보 추가하기"
            style="@style/TextAppearance.App.Body01"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/img_add_pet_profile"
            app:layout_constraintBottom_toBottomOf="@id/img_add_pet_profile"
            app:layout_constraintStart_toEndOf="@id/img_add_pet_profile" />



        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/img_add_pet_profile"/>

        <LinearLayout
            android:id="@+id/layout_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/divider1">

            <TextView
                android:text="서비스"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="알림"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="#000000"
                android:drawableEnd="@drawable/img_arrow_right" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="공지사항"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="#000000"
                android:drawableEnd="@drawable/img_arrow_right" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="고객센터"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="#000000"
                android:drawableEnd="@drawable/img_arrow_right" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="앱 정보"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="#000000"
                android:drawableEnd="@drawable/img_arrow_right" />
        </LinearLayout>

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/layout_service"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>