<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp">


    <ImageView
        android:id="@+id/iv_my_page_pet_select"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/dot_record_unselected"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_my_page_pet_select"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="닉네임"
        android:textSize="16sp"
        style="@style/TextAppearance.App.Body01"
        android:paddingLeft="10dp"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_pet_select"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_pet_select"
        app:layout_constraintStart_toEndOf="@id/iv_my_page_pet_select"/>

    <RadioButton
        android:id="@+id/rb_my_page_pet_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_pet_select"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_pet_select"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>