<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_inquiry_write_submit">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_round_stroke_inquiry"
                android:paddingHorizontal="15dp">
                <Spinner
                    android:id="@+id/sp_inquiry_write_type"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:spinnerMode="dropdown"
                    style="@style/TextAppearance.App.Body02"/>
            </RelativeLayout>

            <EditText
                android:id="@+id/et_inquiry_write_content"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_round_stroke_inquiry"
                android:padding="15dp"
                android:gravity="top"
                android:hint="내용을 자세히 작성해주세요."
                style="@style/TextAppearance.App.Caption01"
                android:textSize="14sp"
                android:inputType="textMultiLine"/>

            <TextView
                android:id="@+id/tv_inquiry_write_text_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/500"
                android:layout_gravity="end"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginTop="5dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사진 첨부"
                style="@style/TextAppearance.App.Body01"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"/>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_inquiry_write_add_photo_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_inquiry_write_add_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="사진을 최대 2장 첨부해주세요."
                    style="@style/TextAppearance.App.Caption01"
                    android:textAlignment="center"
                    android:background="@drawable/bg_round_stroke_inquiry"
                    android:paddingVertical="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:id="@+id/iv_inquiry_write_add_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_gallery_inquiry_write"
                    app:layout_constraintTop_toTopOf="@id/tv_inquiry_write_add_photo"
                    app:layout_constraintBottom_toBottomOf="@id/tv_inquiry_write_add_photo"
                    app:layout_constraintEnd_toEndOf="@id/tv_inquiry_write_add_photo"
                    android:layout_marginEnd="10dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <LinearLayout
                android:id="@+id/layout_inquiry_write_add_photo_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_round_stroke_inquiry"
                android:padding="5dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_inquiry_write_added_photo1"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:background="@color/caption_1"
                    android:layout_weight="1"
                    android:layout_margin="10dp"
                    android:visibility="invisible"/>
                <ImageView
                    android:id="@+id/iv_inquiry_write_added_photo2"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:background="@color/caption_1"
                    android:layout_weight="1"
                    android:layout_margin="10dp"
                    android:visibility="invisible"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_inquiry_write_submit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="제출"
        style="@style/TextAppearance.App.Caption03"
        android:textSize="16sp"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:enabled="false"/>

</androidx.constraintlayout.widget.ConstraintLayout>