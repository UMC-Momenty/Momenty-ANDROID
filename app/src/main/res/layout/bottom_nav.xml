<?xml version="1.0" encoding="utf-8"?>
<!-- 하단 네비게이션 바 레이아웃 (투명 배경) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- 상단 인디케이터 바 -->
    <View
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#000000"
        android:alpha="0.8" />

    <!-- 네비게이션 아이템들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- 기록 -->
        <LinearLayout
            android:id="@+id/nav_record"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_record_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bottom_nav_record"
                android:scaleType="fitCenter"
                app:tint="#C8B4A0" />

            <TextView
                android:id="@+id/nav_record_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기록"
                android:textSize="11sp"
                android:textColor="#C8B4A0"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 일정 관리 -->
        <LinearLayout
            android:id="@+id/nav_calendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_calendar_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bottom_nav_calander"
                android:scaleType="fitCenter"
                app:tint="#C8B4A0" />

            <TextView
                android:id="@+id/nav_calendar_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일정 관리"
                android:textSize="11sp"
                android:textColor="#C8B4A0"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 홈 -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bottom_nav_home"
                android:scaleType="fitCenter"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/nav_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 챗봇 -->
        <LinearLayout
            android:id="@+id/nav_chatbot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_chatbot_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bottom_nav_chatbot"
                android:scaleType="fitCenter"
                app:tint="#C8B4A0" />

            <TextView
                android:id="@+id/nav_chatbot_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="챗봇"
                android:textSize="11sp"
                android:textColor="#C8B4A0"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 마이페이지 -->
        <LinearLayout
            android:id="@+id/nav_mypage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_mypage_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bottom_nav_mypage"
                android:scaleType="fitCenter"
                app:tint="#C8B4A0" />

            <TextView
                android:id="@+id/nav_mypage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="마이페이지"
                android:textSize="11sp"
                android:textColor="#C8B4A0"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>