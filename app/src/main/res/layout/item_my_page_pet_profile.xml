<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/iv_my_page_pet_profile"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginVertical="12dp"
        android:src="@drawable/ic_ellipse_my_page"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


    <TextView
        android:id="@+id/tv_my_page_pet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="반려동물 이름"
        style="@style/TextAppearance.App.Body01"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_pet_profile"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_pet_profile"
        app:layout_constraintStart_toEndOf="@id/iv_my_page_pet_profile" />

    <Button
        android:id="@+id/btn_my_page_manage_pet"
        android:layout_width="120dp"
        android:layout_height="35dp"
        android:text="반려동물 관리"
        style="@style/TextAppearance.App.Caption03"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_pet_profile"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_pet_profile"
        android:layout_marginEnd="24dp"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>