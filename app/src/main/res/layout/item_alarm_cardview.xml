<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 알람 제목 및 토글 -->
        <LinearLayout
            android:id="@+id/ll_title_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="20dp">

            <TextView
                android:id="@+id/tv_alarm_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="산책"
                android:textSize="16sp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="@color/body_1" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumb="@drawable/bg_alarm_switch_thumb"
                app:track="@drawable/bg_alarm_switch_track"
                app:switchMinWidth="48dp"
                app:thumbTint="@null"
                app:trackTint="@null"/>

        </LinearLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="@color/primary" />

        <!-- 자속 시간 -->
        <LinearLayout
            android:id="@+id/ll_duration_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp"
            android:layout_marginHorizontal="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alarm_continue"
                android:textSize="14sp"
                android:textColor="@color/body_1"
                android:fontFamily="@font/pretendard_regular"/>

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1시간"
                android:textSize="14sp"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- 알림 요일 -->
        <LinearLayout
            android:id="@+id/ll_date_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp"
            android:layout_marginHorizontal="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alarm_date"
                android:textSize="14sp"
                android:textColor="@color/body_1"
                android:fontFamily="@font/pretendard_regular"/>

            <TextView
                android:id="@+id/tv_repeat_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="월 화 수"
                android:textSize="14sp"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- 알림 시간 -->
        <LinearLayout
            android:id="@+id/ll_time_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp"
            android:layout_marginHorizontal="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alarm_time"
                android:textSize="14sp"
                android:textColor="@color/body_1"
                android:fontFamily="@font/pretendard_regular"/>

            <TextView
                android:id="@+id/tv_alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오후 07:00"
                android:textSize="14sp"
                android:textColor="#999999" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>