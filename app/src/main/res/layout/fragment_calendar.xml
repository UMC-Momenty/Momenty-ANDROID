<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_sub"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 상단 바 -->
    <ImageView
        android:id="@+id/iv_calendar_back"
        android:layout_width="30dp"
        android:layout_height="35dp"
        android:src="@drawable/img_arrow_left"
        android:layout_marginStart="20dp"
        android:layout_marginTop="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_pet_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calendar_title"
        android:textColor="@color/body_1"
        android:fontFamily="@font/pretendard_semibold"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_calendar_back"
        app:layout_constraintBottom_toBottomOf="@id/iv_calendar_back"/>

    <ImageView
        android:id="@+id/iv_calendar_add"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_add_my_page"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_calendar_back"
        app:layout_constraintBottom_toBottomOf="@id/iv_calendar_back"/>

    <!-- 반려동물 별 필터 (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pet_filter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pet_profile_title"/>

    <!-- 년월 선택 -->
    <LinearLayout
        android:id="@+id/ll_calendar_ym"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_pet_filter">

        <ImageView
            android:id="@+id/iv_month_defore"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/img_arrow_left"
            android:contentDescription="이전 달"/>

        <TextView
            android:id="@+id/tv_year_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:text="2025년 12월"
            android:textColor="@color/body_1"
            android:fontFamily="@font/pretendard_semibold"
            android:textSize="16sp"/>

        <ImageView
            android:id="@+id/iv_month_atfer"
            android:layout_width="18dp"
            android:layout_height="20dp"
            android:src="@drawable/img_arrow_right"
            android:contentDescription="다음 달"/>
    </LinearLayout>

    <!-- 일정 관리 버튼 : 하단 고정 (네비게이션 바 위) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_calendar_manage"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:text="@string/calendar_title"
        android:textColor="@color/white"
        android:fontFamily="@font/pretendard_regular"
        android:textSize="16sp"
        android:background="@drawable/bg_button_agree"
        app:icon="@drawable/ic_calendar_manage_resized"
        app:iconGravity="textStart"
        app:iconPadding="20dp"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/cv_calendar_card" />

    <!-- 달력 카드 : 버튼 위까지 확장 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_calendar_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/ll_calendar_ym"
        app:layout_constraintBottom_toTopOf="@id/btn_calendar_manage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- 요일 헤더 -->
                <LinearLayout
                    android:id="@+id/ll_calendar_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="15dp">
                    <!-- 동적으로 생성됨 -->
                </LinearLayout>

                <!-- 캘린더 그리드 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/calendarRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"/>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>