<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="25dp">

    <ImageView
        android:id="@+id/btn_pet_form_add_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/img_arrow_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tv_pet_form_add_page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="기본 정보"
        android:textSize="24sp"
        style="@style/TextAppearance.App.Body01"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_pet_form_add_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_pet_form_add_back"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btn_pet_form_add_back"
        app:layout_constraintBottom_toTopOf="@id/btn_pet_form_add_save">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:id="@+id/layout_pet_form_add_photo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp">

                <ImageView
                    android:id="@+id/iv_pet_form_pet_profile_edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/dot_record_unselected" />
                <ImageView
                    android:id="@+id/iv_pet_form_pet_profile_edit1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    app:tint="@color/white"
                    android:src="@drawable/dot_record_unselected" />
                <ImageView
                    android:id="@+id/iv_pet_form_pet_profile_edit2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_record_camera_btn"
                    android:padding="4dp"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름 (필수)"
                style="@style/TextAppearance.App.Caption01"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/et_pet_add_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.App.Caption01"
                android:textSize="18sp"
                android:hint="이름"
                android:inputType="textPersonName"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="성별"
                android:textSize="12sp"
                style="@style/TextAppearance.App.Caption01"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioGroup
                    android:id="@+id/rg_pet_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:padding="5dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_gender_selector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_gender_label">

                    <RadioButton
                        android:id="@+id/rb_gender_male"
                        android:layout_width="65dp"
                        android:layout_height="match_parent"
                        android:text="@string/gender_male"
                        android:fontFamily="@font/pretendard_regular"
                        android:textSize="16sp"
                        android:textColor="@color/gender_text_selected"
                        android:button="@null"
                        android:gravity="center"
                        android:background="@drawable/bg_gender_item" />

                    <RadioButton
                        android:id="@+id/rb_gender_female"
                        android:layout_width="65dp"
                        android:layout_height="match_parent"
                        android:text="@string/gender_female"
                        android:fontFamily="@font/pretendard_regular"
                        android:textSize="16sp"
                        android:textColor="@color/gender_text_selected"
                        android:button="@null"
                        android:gravity="center"
                        android:background="@drawable/bg_gender_item" />

                </RadioGroup>

                <View
                    android:layout_width="16dp"
                    android:layout_height="match_parent"/>


                <EditText
                    android:id="@+id/et_pet_form_add_birthday"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:hint="생년월일"
                    android:focusable="false"
                    style="@style/TextAppearance.App.Caption01"
                    android:textSize="18sp"
                    android:padding="10dp"
                    android:drawableEnd="@drawable/ic_bottom_nav_calendar"
                    android:background="@drawable/bg_gender_selector"/>
                <!--
                <TextView
                    android:id="@+id/tv_pet_form_birthdate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="2000.01.01"
                    android:gravity="center"
                    android:background="@drawable/bg_record_round_input"
                    android:textColor="#000000"/>
                -->
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/et_pet_form_add_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="종 (필수)"
                        style="@style/TextAppearance.App.Caption01"
                        android:textSize="18sp"/>
                </LinearLayout>

                <View
                    android:layout_width="16dp"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/et_pet_form_add_type_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="품종 (선택)"
                        style="@style/TextAppearance.App.Caption01"
                        android:textSize="18sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="반려동물 소개"
                android:textSize="12sp"
                style="@style/TextAppearance.App.Caption01"/>

            <EditText
                android:id="@+id/et_pet_form_add_intro"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_record_round_input"
                android:gravity="top|start"
                android:padding="12dp"
                style="@style/TextAppearance.App.Caption01"
                android:textSize="18sp"
                android:hint="내용을 입력해주세요."/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_pet_form_add_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:enabled="false"
        android:text="저장하기"
        android:textSize="16sp"
        style="@style/TextAppearance.App.Caption03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>