<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="25dp">

    <RelativeLayout
        android:id="@+id/rl_write_question_1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_write_question_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/img_arrow_left"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/iv_write_question_logo"
            android:layout_width="129dp"
            android:layout_height="25dp"
            android:src="@drawable/img_logo_orange"
            android:layout_centerInParent="true"/>

        <ImageView
            android:id="@+id/btn_write_question_bookmark_off"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bookmark_off_write_question"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/btn_write_question_bookmark_on"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bookmark_on_write_question"
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

