<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btn_today_back"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_arrow_back_my_page"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_today_logo"
        android:layout_width="129dp"
        android:layout_height="25dp"
        android:src="@drawable/img_logo_orange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_today_back"/>

    <!--
    <TextView
        android:id="@+id/tv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로고"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"/>
    -->

    <ImageView
        android:id="@+id/btn_today_bookmark_off"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_bookmark_off_write_question"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_today_back" />

    <ImageView
        android:id="@+id/btn_today_bookmark_on"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_bookmark_on_write_question"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_today_back" />

    <TextView
        android:id="@+id/tv_today_question_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#000번째 질문"
        android:textColor="@color/body_2"
        android:fontFamily="@font/pretendard_regular"
        android:textSize="12sp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_today_logo"/>

    <TextView
        android:id="@+id/tv_today_question_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="오늘 OO의 기분은 어땠나요?"
        android:textSize="20sp"
        android:textColor="@color/body_1"
        android:fontFamily="@font/pretendard_semibold"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_today_question_number"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_today_input_container"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_edittext_normal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_today_question_content">

        <EditText
            android:id="@+id/et_answer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@null"
            android:gravity="top|start"
            android:hint="답변 입력하기"
            android:fontFamily="@font/pretendard_regular"
            android:textColorHint="@color/neutral_text"
            android:textSize="14sp"
            android:maxLength="300"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_text_count"/>

        <TextView
            android:id="@+id/tv_text_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/300"
            android:textSize="12sp"
            android:textColor="@color/neutral_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:enabled="false"
        android:background="@drawable/bg_button_selector_write_question"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>