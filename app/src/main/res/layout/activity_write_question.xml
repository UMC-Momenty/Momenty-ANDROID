    <TextView
        android:id="@+id/tv_write_question_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#000번째 질문"
        android:textColor="@color/body_2"
        android:fontFamily="@font/pretendard_regular"
        android:textSize="12sp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rl_write_question_1"/>

    <TextView
        android:id="@+id/tv_write_question_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="오늘 OO의 기분은 어땠나요?"
        android:textSize="20sp"
        android:textColor="@color/body_1"
        android:fontFamily="@font/pretendard_semibold"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_write_question_number"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_write_input_container"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_edittext_normal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_write_question_content">

        <TextView
            android:id="@+id/tv_write_question_text_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/300"
            android:textSize="12sp"
            android:textColor="@color/neutral_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/et_write_question_answer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@null"
            android:gravity="top|start"
            android:hint="답변 입력하기"
            android:fontFamily="@font/pretendard_regular"
            android:textColorHint="@color/neutral_text"
            android:textSize="14sp"
            android:maxLength="300"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_write_question_text_count"/>



    </androidx.constraintlayout.widget.ConstraintLayout>

