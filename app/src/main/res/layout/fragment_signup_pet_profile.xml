<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 상단 헤더 -->
    <ImageView
        android:id="@+id/iv_arrow_back"
        android:layout_width="30dp"
        android:layout_height="35dp"
        android:src="@drawable/img_arrow_left"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_pet_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_title"
        android:textColor="@color/body_1"
        android:fontFamily="@font/pretendard_semibold"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/iv_arrow_back"/>

    <!-- 구분선 -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/caption_1"
        android:layout_marginVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_pet_profile_title"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/btn_pet_profile_save">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 프로필 이미지 -->
            <FrameLayout
                android:id="@+id/fl_pet_profile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_pet_profile_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_profile_circle_img" />

                <ImageView
                    android:id="@+id/iv_pet_profile_cam"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:tint="@color/white"
                    android:src="@drawable/dot_record_unselected" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_record_camera_btn"
                    android:padding="4dp"/>

            </FrameLayout>

            <!-- 이름 -->
            <TextView
                android:id="@+id/tv_pet_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/name_field"
                android:fontFamily="@font/pretendard_regular"
                android:textSize="14sp"
                android:textColor="@color/caption_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fl_pet_profile"/>

            <EditText
                android:id="@+id/et_pet_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="3dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:hint="@string/name_hint"
                android:textSize="16sp"
                android:textColorHint="@color/caption_1"
                android:textColor="@color/body_1"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:background="@drawable/bg_edittext_normal"
                android:drawableEnd="@drawable/img_profile_cancel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_pet_name_label"/>

            <!-- 성별 -->
            <TextView
                android:id="@+id/tv_gender_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/gender_field"
                android:fontFamily="@font/pretendard_regular"
                android:textSize="14sp"
                android:textColor="@color/caption_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_pet_name"/>

            <RadioGroup
                android:id="@+id/rg_pet_gender"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="3dp"
                android:padding="5dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_gender_selector"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_gender_label">

                <RadioButton
                    android:id="@+id/rb_gender_male"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/gender_male"
                    android:fontFamily="@font/pretendard_regular"
                    android:textSize="16sp"
                    android:textColor="@color/gender_text_selected"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_gender_item" />

                <RadioButton
                    android:id="@+id/rb_gender_female"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/gender_female"
                    android:fontFamily="@font/pretendard_regular"
                    android:textSize="16sp"
                    android:textColor="@color/gender_text_selected"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_gender_item" />

            </RadioGroup>

            <!-- 생년월일 -->
            <EditText
                android:id="@+id/et_pet_birth"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_edittext_normal"
                android:hint="@string/birth_hint"
                android:textSize="16sp"
                android:textColorHint="@color/caption_1"
                android:textColor="@color/body_1"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:drawableEnd="@drawable/ic_bottom_nav_calendar"
                app:layout_constraintStart_toEndOf="@id/rg_pet_gender"
                app:layout_constraintTop_toTopOf="@id/rg_pet_gender"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/rg_pet_gender"/>

            <!-- 종, 품종 -->
            <TextView
                android:id="@+id/tv_type_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_type"
                android:fontFamily="@font/pretendard_regular"
                android:textSize="14sp"
                android:textColor="@color/caption_1"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="@id/tv_pet_name_label"
                app:layout_constraintTop_toBottomOf="@id/rg_pet_gender"/>

            <EditText
                android:id="@+id/et_pet_type"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginTop="3dp"
                android:paddingStart="20dp"
                android:hint="@string/type_hint"
                android:textColorHint="@color/caption_2"
                android:textColor="@color/body_1"
                android:textSize="16sp"
                android:background="@drawable/bg_edittext_normal"
                app:layout_constraintStart_toStartOf="@id/tv_type_label"
                app:layout_constraintEnd_toEndOf="@id/rg_pet_gender"
                app:layout_constraintTop_toBottomOf="@id/tv_type_label"/>

            <EditText
                android:id="@+id/et_pet_type_detail"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginTop="3dp"
                android:paddingStart="20dp"
                android:hint="@string/name_hint"
                android:textColorHint="@color/caption_2"
                android:textColor="@color/body_1"
                android:textSize="16sp"
                android:background="@drawable/bg_edittext_normal"
                app:layout_constraintStart_toStartOf="@id/et_pet_birth"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_type_label"/>

            <!-- 소개 -->
            <TextView
                android:id="@+id/tv_intro_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_intro"
                android:fontFamily="@font/pretendard_regular"
                android:textSize="14sp"
                android:textColor="@color/caption_1"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="@id/tv_pet_name_label"
                app:layout_constraintTop_toBottomOf="@id/et_pet_type"/>

            <EditText
                android:id="@+id/et_pet_intro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="3dp"
                android:paddingStart="20dp"
                android:hint="@string/name_hint"
                android:textColorHint="@color/caption_2"
                android:textColor="@color/body_1"
                android:textSize="16sp"
                android:background="@drawable/bg_edittext_normal"
                app:layout_constraintStart_toStartOf="@id/tv_type_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_intro_label"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- 저장 버튼 -->
    <Button
        android:id="@+id/btn_pet_profile_save"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:text="@string/save"
        android:textColor="@color/caption_3"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold"
        android:background="@drawable/bg_button_agree"
        android:enabled="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>